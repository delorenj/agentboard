<resources>
    <style name="KeyboardTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/keyboard_background</item>
        <item name="android:colorAccent">@color/terminal_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="MicrophonePermissionTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>

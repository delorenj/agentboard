<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF1E1E1E"
    android:padding="4dp">

    <!-- Toolbar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_esc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Esc"
            android:textSize="13sp"
            android:background="@drawable/key_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_ctrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Ctrl"
            android:textSize="13sp"
            android:background="@drawable/modifier_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_alt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Alt"
            android:textSize="13sp"
            android:background="@drawable/modifier_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Tab"
            android:textSize="13sp"
            android:background="@drawable/key_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_shift_toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⇧"
            android:textSize="16sp"
            android:background="@drawable/modifier_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_enter_toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⏎"
            android:textSize="16sp"
            android:background="@drawable/key_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_backspace_toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌫"
            android:textSize="16sp"
            android:background="@drawable/key_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/key_space_toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="Space"
            android:textSize="13sp"
            android:background="@drawable/key_normal"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Gesture Pads Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <com.zellij.keyboard.GesturePadView
            android:id="@+id/focus_pad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/gesture_pad_bg" />

        <com.zellij.keyboard.GesturePadView
            android:id="@+id/tab_pad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/gesture_pad_bg" />
    </LinearLayout>

    <!-- QWERTY Keyboard -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#FF1E1E1E"
        android:keyBackground="@drawable/key_normal"
        android:keyTextColor="#FFFFFF"
        android:keyPreviewLayout="@null"
        android:shadowColor="#000000"
        android:shadowRadius="0" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_active_pressed" />
            <corners android:radius="@dimen/key_corner_radius" />
            <stroke
                android:width="@dimen/key_border_width"
                android:color="@color/key_border_focused" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_active" />
            <corners android:radius="@dimen/key_corner_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_pressed" />
            <corners android:radius="@dimen/key_corner_radius" />
            <stroke
                android:width="@dimen/key_border_width"
                android:color="@color/key_border_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background" />
            <corners android:radius="@dimen/key_corner_radius" />
            <stroke
                android:width="@dimen/key_border_width"
                android:color="@color/key_border_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background" />
            <corners android:radius="@dimen/key_corner_radius" />
            <stroke
                android:width="@dimen/key_border_width"
                android:color="@color/key_border" />
        </shape>
    </item>
</selector>
